    {
      "name": "Contracts",
      "item": [
        {
          "name": "Upload Contract",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.contract && res.contract.id) {",
                  "    pm.collectionVariables.set('contractId', res.contract.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "samples/contract_risky_1.pdf" },
                { "key": "title", "value": "Vendor Master Services Agreement 2026", "type": "text" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/contracts", "host": ["{{baseUrl}}"], "path": ["api", "contracts"] }
